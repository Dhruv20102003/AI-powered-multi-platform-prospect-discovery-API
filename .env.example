# ==========================================
# Application Configuration
# ==========================================
APP_NAME=AI-Powered Multi-Platform Prospect Discovery API
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=4000
RATE_LIMIT_PER_MINUTE=30

# Optional API key for authenticating incoming requests (Leave blank for public/demo mode)
API_KEY=

# ==========================================
# LLM Provider Configuration
# Supported providers: gemini, openai, anthropic
# ==========================================
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
# Fallback model used if primary fails
LLM_FALLBACK_MODEL=gemini-1.5-flash-latest

# Provide at least one API key corresponding to LLM_PROVIDER
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==========================================
# Search & Platform Discovery Configuration
# ==========================================
# Optional provider override. Leave blank (or remove) to use auto-detection:
#   Serper.dev → SerpAPI → Google CSE → DuckDuckGo (first configured key wins).
# Set to one of: serper, serpapi, google_cse, ddg  to force a specific provider.
SEARCH_ENGINE_PROVIDER=

# Serper.dev Google Search API (Recommended fast search API)
SERPER_API_KEY=

# Google Programmable Search Engine (Custom Search JSON API)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# SerpAPI (Optional high-accuracy multi-engine search API)
SERPAPI_API_KEY=

# YouTube Data API v3 (Uses GOOGLE_CSE_API_KEY if omitted)
YOUTUBE_API_KEY=

# X (Twitter) API v2 Bearer Token (Optional; uses web index if omitted)
TWITTER_BEARER_TOKEN=

# ==========================================
# Scraping & Resilience Configuration
# ==========================================
HTTP_TIMEOUT_SECONDS=8.0
MAX_CONCURRENT_PLATFORMS=9
CACHE_TTL_SECONDS=3600
MAX_REQUEST_SIZE_BYTES=65536
